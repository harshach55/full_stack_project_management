                  },
                  "startDate": {
                    "type": "string",
                    "nullable": true
                  },
                  "endDate": {
                    "type": "string",
                    "nullable": true
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created project.",
