        "summary": "Log in",
        "description": "Web clients receive the session in an httpOnly cookie and only the user in the body. Mobile clients send X-Client-Type: mobile (and no Origin header) and receive the token in the body.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "mobile"
              ],
              "description": "Send \"mobile\" (without an Origin header) to receive the token in the response body instead of a cookie."
            },
            "required": false,
            "description": "Send \"mobile\" (without an Origin header) to receive the token in the response body instead of a cookie.",
            "name": "x-client-type",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
