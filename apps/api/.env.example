# API environment variables. Copy to apps/api/.env for local development.
# .env is git-ignored and never committed. No real values belong in this file.

NODE_ENV=development
PORT=4000

# Runtime database connection (required): a PostgreSQL connection URL.
# Local: the pm_dev database of the Docker PostgreSQL (user pm, host localhost,
#        port 5433, password = your PM_LOCAL_DB_PASSWORD). See apps/api/README.md.
# Production: the Supabase pooler URL in transaction mode (port 6543) with ?sslmode=verify-full,
#             set on Render (docs/deployment.md).
DATABASE_URL=

# Direct/session connection used only by Prisma migration commands, and only on the
# machine that runs migrations. Locally it is the same as DATABASE_URL.
# Not configured on Render (ADR-0011).
DIRECT_URL=

# HS256 signing key (required): at least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Exact web origins allowed for CORS and the Origin check (comma-separated, no trailing slash).
# Local: the Next.js dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Must be true in production. false only for local HTTP development.
COOKIE_SECURE=false

# Number of proxies in front of the API: 1 on Render, 0 locally.
TRUST_PROXY_HOPS=0

# Rate limits (defaults shown).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=50
RATE_LIMIT_REGISTER_IP_MAX=10

# Optional: fatal, error, warn, info, debug, trace, silent.
# LOG_LEVEL=debug
