# Production database settings for running migrations from a developer machine (ADR-0011).
# Copy to apps/api/.env.production (git-ignored, never committed) and fill in the values
# from the Supabase dashboard (docs/deployment.md, section "Database"). Used only by
# scripts/prisma-production.mjs (pnpm --filter @pm/api db:prod:check|status|deploy).
# The running API on Render receives DATABASE_URL through Render's environment settings.

# Transaction pooler (port 6543), ending in ?sslmode=verify-full (required by the script).
# The same value is set as DATABASE_URL on Render.
DATABASE_URL=

# Session pooler (port 5432). Used only by Prisma migration commands; never set on Render.
# The script always adds strict TLS verification against certs/prod-ca-2021.crt.
DIRECT_URL=
