# Test database settings. Copy to apps/api/.env.test (git-ignored), or export the
# variables in your shell. Values set in the shell take precedence.

# Required: connection URL of the local test database. Tests refuse to run unless the
# host is localhost (or 127.0.0.1) and the database name ends in "_test".
# Local Docker value: database pm_test on localhost:5433, user pm, password = your
# PM_LOCAL_DB_PASSWORD. See apps/api/README.md.
TEST_DATABASE_URL=

# Optional: direct (non-pooled) connection used for migrations when TEST_DATABASE_URL
# points at a connection pooler. Defaults to TEST_DATABASE_URL.
TEST_DIRECT_DATABASE_URL=
