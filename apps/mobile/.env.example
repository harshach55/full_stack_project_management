# Mobile app environment. Copy to apps/mobile/.env.local (git-ignored).
# EXPO_PUBLIC_ variables are embedded in the app bundle: never put secrets here.

# Base URL of the Express API (origin only, no trailing slash). There is no default.
# Android emulator talking to an API on this computer: http://10.0.2.2:4000
#   (inside the emulator, "localhost" is the emulator itself; 10.0.2.2 is the host).
# Physical Android device (Expo Go) on the same Wi-Fi: http://<your-computer-LAN-IP>:4000
# Production API (Render): https://pm-api-lb5m.onrender.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
