# Web app environment variables. Copy to apps/web/.env.local for local development
# (git-ignored). No secrets belong here: the web app holds no credentials.

# Origin of the Express API that /api/* is forwarded to (server-side only, read at build
# time; it is not exposed to browser code). Defaults to http://localhost:4000 in development.
# Production (Vercel): the Render API origin, for example https://<api-service>.onrender.com
API_ORIGIN=http://localhost:4000
