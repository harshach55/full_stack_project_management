# Local Docker PostgreSQL (docker-compose.yml). Copy to .env in the repository root;
# .env is git-ignored and never committed.
#
# Choose any password for your local database. It is used only by the local
# container and by the connection URLs you put in apps/api/.env and apps/api/.env.test.
# If you change it later, recreate the container volume: docker compose down -v
PM_LOCAL_DB_PASSWORD=
